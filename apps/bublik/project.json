{
	"name": "bublik",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/bublik/src",
	"projectType": "application",
	"tags": [],
	"targets": {
		"build": {
			"executor": "@nx/vite:build",
			"outputs": ["{options.outputPath}"],
			"options": {
				"outputPath": "dist/apps/bublik"
			},
			"configurations": {
				"production": {
					"base": "/v2",
					"sourcemap": false
				}
			}
		},
		"serve": {
			"executor": "@nx/vite:dev-server",
			"options": {
				"buildTarget": "bublik:build",
				"hmr": true
			},
			"configurations": {}
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		},
		"test": {
			"executor": "@nx/vitest:test",
			"outputs": ["{workspaceRoot}/coverage/apps/bublik"],
			"options": {
				"passWithNoTests": true
			}
		},
		"preview": {
			"dependsOn": ["build"],
			"executor": "@nx/vite:preview-server",
			"defaultConfiguration": "production",
			"options": {
				"buildTarget": "bublik:build",
				"port": 4400
			},
			"configurations": {
				"production": {
					"buildTarget": "bublik:build:production"
				}
			}
		},
		"e2e-typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc --noEmit -p apps/bublik/tsconfig.e2e.json"
			}
		},
		"e2e-features-check": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node ./tools/check-e2e-features.cjs"
			}
		},
		"e2e": {
			"cache": false,
			"dependsOn": ["e2e-typecheck", "e2e-features-check"],
			"executor": "@nx/playwright:playwright",
			"outputs": ["{workspaceRoot}/dist/.playwright/apps/bublik"],
			"options": {
				"config": "apps/bublik/playwright.config.ts"
			}
		}
	}
}
