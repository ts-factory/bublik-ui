{
	"extends": [
		"plugin:@nx/react",
		"plugin:@tanstack/router/recommended",
		"../../.eslintrc.json"
	],
	"ignorePatterns": [
		"!**/*",
		"**/vite.config.*.timestamp*",
		"**/vitest.config.*.timestamp*",
		"src/routeTree.gen.ts"
	],
	"overrides": [
		{
			"files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
			"rules": {}
		},
		{
			"files": ["*.ts", "*.tsx"],
			"rules": {}
		},
		{
			"files": ["*.js", "*.jsx"],
			"rules": {}
		},
		{
			"files": ["e2e/**/*.{ts,js,tsx,jsx}"],
			"extends": ["plugin:playwright/recommended"],
			"rules": {}
		}
	]
}
