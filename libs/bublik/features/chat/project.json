{
	"name": "bublik-features-chat",
	"$schema": "../../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "libs/bublik/features/chat/src",
	"projectType": "library",
	"tags": [],
	"targets": {
		"lint": {
			"executor": "@nx/eslint:lint",
			"outputs": ["{options.outputFile}"],
			"options": {
				"lintFilePatterns": ["libs/bublik/features/chat/**/*.{ts,tsx,js,jsx}"]
			}
		},
		"test": {
			"executor": "@nx/vitest:test",
			"outputs": ["{workspaceRoot}/coverage/libs/bublik/features/chat"],
			"options": {
				"passWithNoTests": true,
				"reportsDirectory": "../../../../coverage/libs/bublik/features/chat"
			}
		}
	}
}
